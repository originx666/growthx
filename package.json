{
  "name": "geruosi",
  "version": "1.1.0",
  "description": "歌若思：本地优先的项目制学习与终身学习生涯管理工具",
  "main": "electron/main.cjs",
  "author": "歌若思开源项目",
  "license": "AGPL-3.0-only",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win nsis portable && node scripts/publish-release.cjs",
    "pack:win": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.geruosi.desktop",
    "productName": "歌若思",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": ".build-output",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "canvas.js",
      "canvas.css",
      "career-covers.js",
      "career-covers.css",
      "ai-consultation.js",
      "ai-consultation.css",
      "discovery.js",
      "discovery.css",
      "modern.css",
      "assets/**/*",
      "electron/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "origin.js",
      "origin.css"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "歌若思"
    }
  },
  "dependencies": {
    "pdfjs-dist": "5.4.296"
  }
}
